<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tareas del Día | Gestor de Casos</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    {{> header}}

    <main class="tasks-layout">
        <!-- Nivel Superior: Ancho completo -->
        <section class="tasks-header-card">
            <div class="tasks-header-card__left">
                <span class="tasks-header-card__icon">&#9745;</span>
                <div class="tasks-header-card__titles">
                    <h2 class="tasks-header-card__title">Gestión del Día</h2>
                    <p class="tasks-header-card__date">Actividades y vencimientos sincronizados con la base de datos</p>
                </div>
            </div>
            <div class="tasks-header-card__right">
                <a href="/" class="tasks-header-card__btn-new">+ Nueva Tarea / Caso</a>
            </div>
        </section>

        <!-- Nivel Inferior: 2 columnas 50/50 -->
        <div class="tasks-content">
            <!-- Columna Izquierda: Tareas Diarias / Vencimientos de Casos -->
            <section class="tasks-list-card">
                <div class="tasks-list-card__header">
                    <h3 class="tasks-list-card__title">Tareas y Plazos de Casos</h3>
                </div>
                <ul class="tasks-list">
                    {{#casos}}
                        {{#fecha_vencimiento}}
                        <li class="tasks-list__item">
                            <label class="tasks-list__label">
                                <input type="checkbox" class="tasks-list__checkbox">
                                <div>
                                    <span class="tasks-list__text">{{titulo}}</span>
                                    <small style="display:block; color:#888;">Plazo: {{fecha_vencimiento}} ({{tipo}})</small>
                                </div>
                            </label>
                        </li>
                        {{/fecha_vencimiento}}
                    {{/casos}}
                    {{^casos}}
                        <li class="tasks-list__item">No hay tareas pendientes registradas.</li>
                    {{/casos}}
                </ul>
            </section>

            <!-- Columna Derecha: Eventos y Audiencias -->
            <section class="events-list-card">
                <div class="events-list-card__header">
                    <h3 class="events-list-card__title">Audiencias y Eventos</h3>
                </div>
                <div class="events-list">
                    {{#casos}}
                        {{#tiene_audiencia}}
                        <article class="event-card">
                            <div class="event-card__select">
                                <input type="checkbox" class="event-card__checkbox">
                            </div>
                            <div class="event-card__body">
                                <div class="event-card__meta">
                                    <span class="event-card__tag event-card__tag--audiencia">Audiencia</span>
                                    <span class="event-card__time">{{fecha_audiencia}}</span>
                                </div>
                                <h4 class="event-card__title">{{titulo}}</h4>
                                <p class="event-card__desc">{{descripcion}}</p>
                            </div>
                        </article>
                        {{/tiene_audiencia}}
                    {{/casos}}
                    {{^casos}}
                        <p style="font-size:0.85rem; color:#777;">No hay audiencias agendadas.</p>
                    {{/casos}}
                </div>
            </section>
        </div>
    </main>

    {{> footer}}
</body>
</html>
