<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendario | Gestor de Casos</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    {{> header}}

    <main class="calendar-layout">
        <!-- Nivel Superior: Ancho completo -->
        <section class="calendar-header-card">
            <div class="calendar-header-card__left">
                <span class="calendar-header-card__icon">&#128197;</span>
                <div class="calendar-header-card__titles">
                    <h2 class="calendar-header-card__title">Septiembre 2026</h2>
                    <p class="calendar-header-card__subtitle">Agenda de audiencias y plazos procesales vinculados a la base de datos</p>
                </div>
            </div>
            <div class="calendar-header-card__right">
                <button type="button" class="calendar-header-card__btn calendar-header-card__btn--today">Hoy</button>
                <div class="calendar-header-card__nav-group">
                    <button type="button" class="calendar-header-card__btn calendar-header-card__btn--nav">&lt;</button>
                    <button type="button" class="calendar-header-card__btn calendar-header-card__btn--nav">&gt;</button>
                </div>
                <a href="/" class="calendar-header-card__btn calendar-header-card__btn--primary">+ Agendar Evento</a>
            </div>
        </section>

        <!-- Nivel Inferior: 2 columnas -->
        <div class="calendar-content">
            <!-- Columna izquierda: Grilla del calendario -->
            <section class="calendar-main-card">
                <div class="calendar-grid-header">
                    <span class="calendar-grid-header__day">Lun</span>
                    <span class="calendar-grid-header__day">Mar</span>
                    <span class="calendar-grid-header__day">Mié</span>
                    <span class="calendar-grid-header__day">Jue</span>
                    <span class="calendar-grid-header__day">Vie</span>
                    <span class="calendar-grid-header__day">Sáb</span>
                    <span class="calendar-grid-header__day">Dom</span>
                </div>
                <div class="calendar-grid">
                    <div class="calendar-grid__cell calendar-grid__cell--muted">31</div>
                    <div class="calendar-grid__cell">1</div>
                    <div class="calendar-grid__cell">2</div>
                    <div class="calendar-grid__cell">3</div>
                    <div class="calendar-grid__cell">4</div>
                    <div class="calendar-grid__cell">5</div>
                    <div class="calendar-grid__cell">6</div>
                    <div class="calendar-grid__cell">7</div>
                    <div class="calendar-grid__cell">8</div>
                    <div class="calendar-grid__cell">9</div>
                    <div class="calendar-grid__cell">10</div>
                    <div class="calendar-grid__cell">11</div>
                    <div class="calendar-grid__cell">12</div>
                    <div class="calendar-grid__cell">13</div>
                    <div class="calendar-grid__cell">14</div>
                    <div class="calendar-grid__cell">15</div>
                    <div class="calendar-grid__cell">16</div>
                    <div class="calendar-grid__cell calendar-grid__cell--active">17</div>
                    <div class="calendar-grid__cell">18</div>
                    <div class="calendar-grid__cell">19</div>
                    <div class="calendar-grid__cell">20</div>
                    <div class="calendar-grid__cell">21</div>
                    <div class="calendar-grid__cell">22</div>
                    <div class="calendar-grid__cell">23</div>
                    <div class="calendar-grid__cell">24</div>
                    <div class="calendar-grid__cell">25</div>
                    <div class="calendar-grid__cell">26</div>
                    <div class="calendar-grid__cell">27</div>
                    <div class="calendar-grid__cell">28</div>
                    <div class="calendar-grid__cell">29</div>
                    <div class="calendar-grid__cell">30</div>
                    <div class="calendar-grid__cell calendar-grid__cell--muted">1</div>
                    <div class="calendar-grid__cell calendar-grid__cell--muted">2</div>
                    <div class="calendar-grid__cell calendar-grid__cell--muted">3</div>
                    <div class="calendar-grid__cell calendar-grid__cell--muted">4</div>
                </div>
            </section>

            <!-- Columna derecha: Eventos vinculados al día desde la DB -->
            <aside class="calendar-sidebar-card">
                <div class="calendar-sidebar-card__header">
                    <div class="calendar-sidebar-card__titles">
                        <span class="calendar-sidebar-card__badge">EVENTOS VINCULADOS</span>
                        <h3 class="calendar-sidebar-card__date">Actividades de Casos</h3>
                    </div>
                    <a href="/" class="calendar-sidebar-card__btn-new">+ Nuevo</a>
                </div>

                <div class="calendar-events-list">
                    {{#casos}}
                        {{#tiene_audiencia}}
                        <article class="event-card">
                            <div class="event-card__select">
                                <input type="checkbox" class="event-card__checkbox">
                            </div>
                            <div class="event-card__body">
                                <div class="event-card__meta">
                                    <span class="event-card__tag event-card__tag--audiencia">Audiencia</span>
                                    <span class="event-card__time">{{fecha_audiencia}}</span>
                                </div>
                                <h4 class="event-card__title">{{titulo}}</h4>
                                <p class="event-card__desc">{{descripcion}}</p>
                            </div>
                        </article>
                        {{/tiene_audiencia}}

                        {{#fecha_vencimiento}}
                        <article class="event-card">
                            <div class="event-card__select">
                                <input type="checkbox" class="event-card__checkbox">
                            </div>
                            <div class="event-card__body">
                                <div class="event-card__meta">
                                    <span class="event-card__tag event-card__tag--plazo">Vencimiento</span>
                                    <span class="event-card__time">{{fecha_vencimiento}}</span>
                                </div>
                                <h4 class="event-card__title">Plazo: {{titulo}}</h4>
                                <p class="event-card__desc">{{descripcion}}</p>
                            </div>
                        </article>
                        {{/fecha_vencimiento}}
                    {{/casos}}
                    {{^casos}}
                        <p style="font-size:0.85rem; color:#777;">No hay casos con fechas registradas aún.</p>
                    {{/casos}}
                </div>
            </aside>
        </div>
    </main>

    {{> footer}}
</body>
</html>
