<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendario Procesal - Gestor de casos</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text x=%2250%%22 y=%2255%%22 font-size=%2275%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22>⚖️</text></svg>">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    {{> header}}

    <main class="calendar-layout">
        <!-- Nivel Superior: Cabecera con selector de mes y controles -->
        <section class="calendar-header-card">
            <div class="calendar-header-card__left">
                <span class="calendar-header-card__icon">&#128197;</span>
                <div class="calendar-header-card__titles">
                    <h2 class="calendar-header-card__title" id="calendarMonthYear">Septiembre 2026</h2>
                    <p class="calendar-header-card__subtitle">Agenda de audiencias, vencimientos y tareas procesales</p>
                </div>
            </div>
            <div class="calendar-header-card__right">
                <button type="button" class="calendar-header-card__btn calendar-header-card__btn--today" id="btnCalToday">Hoy</button>
                <div class="calendar-header-card__nav-group">
                    <button type="button" class="calendar-header-card__btn calendar-header-card__btn--nav" id="btnCalPrev" title="Mes anterior">&lt;</button>
                    <button type="button" class="calendar-header-card__btn calendar-header-card__btn--nav" id="btnCalNext" title="Mes siguiente">&gt;</button>
                </div>
                <a href="/" class="calendar-header-card__btn calendar-header-card__btn--primary">+ Nuevo Caso</a>
            </div>
        </section>

        <!-- Nivel Inferior: 2 columnas (Grilla interactiva + Eventos del día) -->
        <div class="calendar-content">
            <!-- Columna izquierda: Grilla del calendario -->
            <section class="calendar-main-card">
                <div class="calendar-grid-header">
                    <span class="calendar-grid-header__day">Lun</span>
                    <span class="calendar-grid-header__day">Mar</span>
                    <span class="calendar-grid-header__day">Mié</span>
                    <span class="calendar-grid-header__day">Jue</span>
                    <span class="calendar-grid-header__day">Vie</span>
                    <span class="calendar-grid-header__day">Sáb</span>
                    <span class="calendar-grid-header__day">Dom</span>
                </div>
                <div class="calendar-grid" id="calendarGrid">
                    <!-- Generado dinámicamente con JavaScript -->
                </div>
            </section>

            <!-- Columna derecha: Eventos vinculados al día seleccionado -->
            <aside class="calendar-sidebar-card">
                <div class="calendar-sidebar-card__header">
                    <div class="calendar-sidebar-card__titles">
                        <span class="calendar-sidebar-card__badge" id="selectedDateBadge">EVENTOS DEL DÍA</span>
                        <h3 class="calendar-sidebar-card__date" id="selectedDateHeading">Cargando...</h3>
                        <span class="calendar-sidebar-card__counter" id="selectedDateCounter">0 actividades registradas</span>
                    </div>
                    <button type="button" class="calendar-sidebar-card__btn-new" id="btnToggleNewTask" title="Agregar tarea a este día">+ Tarea</button>
                </div>

                <!-- Formulario inline para agregar tarea a la fecha seleccionada -->
                <form id="formAddDayTask" class="calendar-add-task-form" style="display: none;">
                    <input type="text" id="inputDayTaskText" class="calendar-add-task-input" placeholder="Nueva tarea para esta fecha..." maxlength="120" required autocomplete="off">
                    <div class="calendar-add-task-actions">
                        <button type="submit" class="calendar-btn-save">Guardar</button>
                        <button type="button" class="calendar-btn-cancel" id="btnCancelDayTask">&times;</button>
                    </div>
                </form>

                <!-- Lista de eventos y tareas del día seleccionado -->
                <div class="calendar-events-list" id="calendarEventsList">
                    <!-- Se renderiza vía JavaScript -->
                </div>
            </aside>
        </div>

        <!-- Datos ocultos de eventos desde la base de datos -->
        <div id="serverCalendarEvents" style="display: none;">
            {{#eventos}}
                <span data-id="{{id}}" data-caso-id="{{caso_id}}" data-titulo="{{titulo}}" data-desc="{{descripcion}}" data-tipo="{{tipo}}" data-tipo-slug="{{tipo_slug}}" data-fecha="{{fecha}}" data-hora="{{hora}}"></span>
            {{/eventos}}
        </div>
    </main>

    <script>
        // Datos de eventos del servidor
        const serverEventNodes = document.querySelectorAll('#serverCalendarEvents span');
        const serverEvents = Array.from(serverEventNodes).map(el => ({
            id: el.dataset.id || ('ev_' + Math.random()),
            casoId: el.dataset.casoId,
            titulo: el.dataset.titulo || 'Sin título',
            descripcion: el.dataset.desc || '',
            tipo: el.dataset.tipo || 'Evento',
            tipoSlug: el.dataset.tipoSlug || 'plazo',
            fecha: el.dataset.fecha || '',
            hora: el.dataset.hora || 'Todo el día',
            isCustom: false
        }));

        // Tareas personalizadas guardadas por fecha en localStorage
        const CALENDAR_CUSTOM_TASKS_KEY = 'gdc_calendar_custom_tasks_v1';
        const CALENDAR_COMPLETED_KEY = 'gdc_calendar_completed_v1';

        let customTasks = [];
        try {
            const stored = localStorage.getItem(CALENDAR_CUSTOM_TASKS_KEY);
            if (stored) customTasks = JSON.parse(stored);
        } catch (e) {
            customTasks = [];
        }

        let completedItems = {};
        try {
            const storedCompleted = localStorage.getItem(CALENDAR_COMPLETED_KEY);
            if (storedCompleted) completedItems = JSON.parse(storedCompleted);
        } catch (e) {
            completedItems = {};
        }

        function saveCustomTasks() {
            try {
                localStorage.setItem(CALENDAR_CUSTOM_TASKS_KEY, JSON.stringify(customTasks));
            } catch (e) {}
        }

        function saveCompletedItems() {
            try {
                localStorage.setItem(CALENDAR_COMPLETED_KEY, JSON.stringify(completedItems));
            } catch (e) {}
        }

        // Estado del calendario
        const now = new Date();
        const pad = (n) => String(n).padStart(2, '0');
        const todayStr = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

        let currentYear = now.getFullYear();
        let currentMonth = now.getMonth(); // 0-indexed
        let selectedDateStr = todayStr;

        const MONTH_NAMES = [
            'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
            'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
        ];

        function getEventsForDate(dateStr) {
            const evs = serverEvents.filter(e => e.fecha === dateStr);
            const tasks = customTasks.filter(t => t.fecha === dateStr);
            return [...evs, ...tasks];
        }

        function renderCalendar() {
            const titleEl = document.getElementById('calendarMonthYear');
            const gridEl = document.getElementById('calendarGrid');
            if (!titleEl || !gridEl) return;

            titleEl.textContent = `${MONTH_NAMES[currentMonth]} ${currentYear}`;
            gridEl.innerHTML = '';

            // Primer día del mes (0 = Domingo -> ajustamos a 0 = Lunes)
            const firstDayOfMonth = new Date(currentYear, currentMonth, 1).getDay();
            const startDayIndex = (firstDayOfMonth + 6) % 7;

            // Cantidad de días en el mes actual y anterior
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            const daysInPrevMonth = new Date(currentYear, currentMonth, 0).getDate();

            // 1. Días del mes anterior (muted)
            for (let i = startDayIndex - 1; i >= 0; i--) {
                const dayNum = daysInPrevMonth - i;
                const prevM = currentMonth === 0 ? 11 : currentMonth - 1;
                const prevY = currentMonth === 0 ? currentYear - 1 : currentYear;
                const dateStr = `${prevY}-${pad(prevM + 1)}-${pad(dayNum)}`;

                const cell = createDayCell(dayNum, dateStr, true);
                gridEl.appendChild(cell);
            }

            // 2. Días del mes actual
            for (let dayNum = 1; dayNum <= daysInMonth; dayNum++) {
                const dateStr = `${currentYear}-${pad(currentMonth + 1)}-${pad(dayNum)}`;
                const cell = createDayCell(dayNum, dateStr, false);
                gridEl.appendChild(cell);
            }

            // 3. Días del mes siguiente (muted) para completar cuadrícula (35 o 42 celdas)
            const totalRendered = startDayIndex + daysInMonth;
            const targetTotal = totalRendered > 35 ? 42 : 35;
            const remaining = targetTotal - totalRendered;

            for (let dayNum = 1; dayNum <= remaining; dayNum++) {
                const nextM = currentMonth === 11 ? 0 : currentMonth + 1;
                const nextY = currentMonth === 11 ? currentYear + 1 : currentYear;
                const dateStr = `${nextY}-${pad(nextM + 1)}-${pad(dayNum)}`;

                const cell = createDayCell(dayNum, dateStr, true);
                gridEl.appendChild(cell);
            }
        }

        function createDayCell(dayNum, dateStr, isMuted) {
            const cell = document.createElement('div');
            const isToday = dateStr === todayStr;
            const isSelected = dateStr === selectedDateStr;
            const dayEvents = getEventsForDate(dateStr);

            cell.className = 'calendar-grid__cell' +
                (isMuted ? ' calendar-grid__cell--muted' : '') +
                (isToday ? ' calendar-grid__cell--today' : '') +
                (isSelected ? ' calendar-grid__cell--active' : '');

            cell.dataset.date = dateStr;

            // Encabezado de la celda (número de día y contador)
            const header = document.createElement('div');
            header.className = 'calendar-grid__cell-header';

            const numSpan = document.createElement('span');
            numSpan.className = 'calendar-grid__day-number';
            numSpan.textContent = dayNum;
            header.appendChild(numSpan);

            if (dayEvents.length > 0) {
                const countBadge = document.createElement('span');
                countBadge.className = 'calendar-grid__event-count';
                countBadge.textContent = dayEvents.length;
                header.appendChild(countBadge);
            }

            cell.appendChild(header);

            // Vista previa de eventos / chips dentro de la celda
            const preview = document.createElement('div');
            preview.className = 'calendar-grid__events-preview';

            dayEvents.slice(0, 2).forEach(ev => {
                const chip = document.createElement('div');
                chip.className = 'calendar-chip calendar-chip--' + (ev.tipoSlug || 'plazo');
                chip.title = `${ev.tipo}: ${ev.titulo}`;

                const dot = document.createElement('span');
                dot.className = 'calendar-chip__dot';

                const text = document.createElement('span');
                text.className = 'calendar-chip__text';
                const timeStr = (ev.hora && ev.hora !== 'Todo el día' && ev.hora !== 'Horario a confirmar') ? (ev.hora.replace(' hs', '') + ' ') : '';
                text.textContent = timeStr + ev.titulo;

                chip.appendChild(dot);
                chip.appendChild(text);
                preview.appendChild(chip);
            });

            if (dayEvents.length > 2) {
                const more = document.createElement('span');
                more.className = 'calendar-chip__more';
                more.textContent = `+${dayEvents.length - 2} más`;
                preview.appendChild(more);
            }

            cell.appendChild(preview);

            cell.addEventListener('click', () => {
                selectedDateStr = dateStr;

                // Si se hace clic en un día muted de otro mes, navegar a ese mes
                const parts = dateStr.split('-');
                const cellYear = parseInt(parts[0], 10);
                const cellMonth = parseInt(parts[1], 10) - 1;
                if (cellMonth !== currentMonth || cellYear !== currentYear) {
                    currentYear = cellYear;
                    currentMonth = cellMonth;
                    renderCalendar();
                } else {
                    document.querySelectorAll('.calendar-grid__cell').forEach(c => {
                        c.classList.toggle('calendar-grid__cell--active', c.dataset.date === selectedDateStr);
                    });
                }

                renderDayEvents(selectedDateStr);
            });

            return cell;
        }

        function renderDayEvents(dateStr) {
            const badgeEl = document.getElementById('selectedDateBadge');
            const headingEl = document.getElementById('selectedDateHeading');
            const counterEl = document.getElementById('selectedDateCounter');
            const listEl = document.getElementById('calendarEventsList');
            if (!headingEl || !listEl) return;

            // Formatear fecha legible
            const [y, m, d] = dateStr.split('-').map(Number);
            const dateObj = new Date(y, m - 1, d);
            const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
            let legible = dateObj.toLocaleDateString('es-AR', options);
            if (legible) legible = legible.charAt(0).toUpperCase() + legible.slice(1);

            headingEl.textContent = legible;
            if (badgeEl) {
                badgeEl.textContent = dateStr === todayStr ? 'EVENTOS DE HOY' : 'EVENTOS DEL DÍA';
            }

            const events = getEventsForDate(dateStr);
            if (counterEl) {
                if (events.length === 0) {
                    counterEl.textContent = 'Sin actividades registradas';
                } else if (events.length === 1) {
                    counterEl.textContent = '1 actividad programada';
                } else {
                    counterEl.textContent = `${events.length} actividades programadas`;
                }
            }

            listEl.innerHTML = '';

            if (events.length === 0) {
                listEl.innerHTML = `
                    <div class="calendar-events-empty">
                        <div class="calendar-events-empty__icon">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <p class="calendar-events-empty__title">Sin actividades programadas</p>
                        <p class="calendar-events-empty__desc">No hay vencimientos, audiencias ni tareas registradas para esta fecha.</p>
                    </div>
                `;
                return;
            }

            events.forEach(ev => {
                const isDone = !!completedItems[ev.id];
                const card = document.createElement('article');
                card.className = `event-card event-card--${ev.tipoSlug || 'plazo'}` + (isDone ? ' event-card--done' : '');

                const selectDiv = document.createElement('div');
                selectDiv.className = 'event-card__select';

                const chk = document.createElement('input');
                chk.type = 'checkbox';
                chk.className = 'event-card__checkbox';
                chk.checked = isDone;
                chk.title = isDone ? 'Marcar como pendiente' : 'Marcar como completado';
                chk.addEventListener('change', () => {
                    if (chk.checked) {
                        completedItems[ev.id] = true;
                    } else {
                        delete completedItems[ev.id];
                    }
                    saveCompletedItems();
                    card.classList.toggle('event-card--done', chk.checked);
                });
                selectDiv.appendChild(chk);

                const bodyDiv = document.createElement('div');
                bodyDiv.className = 'event-card__body';

                const metaDiv = document.createElement('div');
                metaDiv.className = 'event-card__meta';

                const tagSpan = document.createElement('span');
                tagSpan.className = `event-card__tag event-card__tag--${ev.tipoSlug || 'plazo'}`;
                tagSpan.textContent = ev.tipo;

                const timeSpan = document.createElement('span');
                timeSpan.className = 'event-card__time';
                timeSpan.innerHTML = `
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    ${ev.hora}
                `;

                metaDiv.appendChild(tagSpan);
                metaDiv.appendChild(timeSpan);

                const titleH4 = document.createElement('h4');
                titleH4.className = 'event-card__title';
                titleH4.textContent = ev.titulo;

                bodyDiv.appendChild(metaDiv);
                bodyDiv.appendChild(titleH4);

                if (ev.descripcion) {
                    const descP = document.createElement('p');
                    descP.className = 'event-card__desc';
                    descP.textContent = ev.descripcion;
                    bodyDiv.appendChild(descP);
                }

                card.appendChild(selectDiv);
                card.appendChild(bodyDiv);

                // Botón eliminar para tareas personalizadas agregadas en calendario
                if (ev.isCustom) {
                    const delBtn = document.createElement('button');
                    delBtn.type = 'button';
                    delBtn.className = 'event-card__btn-del';
                    delBtn.innerHTML = '&times;';
                    delBtn.title = 'Eliminar tarea';
                    delBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        customTasks = customTasks.filter(t => t.id !== ev.id);
                        delete completedItems[ev.id];
                        saveCustomTasks();
                        saveCompletedItems();
                        renderCalendar();
                        renderDayEvents(selectedDateStr);
                    });
                    card.appendChild(delBtn);
                }

                listEl.appendChild(card);
            });
        }

        // Navegación de meses
        const btnPrev = document.getElementById('btnCalPrev');
        const btnNext = document.getElementById('btnCalNext');
        const btnToday = document.getElementById('btnCalToday');

        if (btnPrev) {
            btnPrev.addEventListener('click', () => {
                currentMonth--;
                if (currentMonth < 0) {
                    currentMonth = 11;
                    currentYear--;
                }
                renderCalendar();
            });
        }

        if (btnNext) {
            btnNext.addEventListener('click', () => {
                currentMonth++;
                if (currentMonth > 11) {
                    currentMonth = 0;
                    currentYear++;
                }
                renderCalendar();
            });
        }

        if (btnToday) {
            btnToday.addEventListener('click', () => {
                const today = new Date();
                currentYear = today.getFullYear();
                currentMonth = today.getMonth();
                selectedDateStr = todayStr;
                renderCalendar();
                renderDayEvents(selectedDateStr);
            });
        }

        // Formulario inline para agregar tarea a la fecha seleccionada
        const btnToggleTask = document.getElementById('btnToggleNewTask');
        const formAddDayTask = document.getElementById('formAddDayTask');
        const inputDayTaskText = document.getElementById('inputDayTaskText');
        const btnCancelDayTask = document.getElementById('btnCancelDayTask');

        if (btnToggleTask && formAddDayTask) {
            btnToggleTask.addEventListener('click', () => {
                const isHidden = formAddDayTask.style.display === 'none';
                formAddDayTask.style.display = isHidden ? 'flex' : 'none';
                if (isHidden && inputDayTaskText) {
                    inputDayTaskText.focus();
                }
            });
        }

        if (btnCancelDayTask && formAddDayTask) {
            btnCancelDayTask.addEventListener('click', () => {
                formAddDayTask.style.display = 'none';
                if (inputDayTaskText) inputDayTaskText.value = '';
            });
        }

        if (formAddDayTask && inputDayTaskText) {
            formAddDayTask.addEventListener('submit', (e) => {
                e.preventDefault();
                const val = inputDayTaskText.value.trim();
                if (!val) return;

                customTasks.push({
                    id: 'task_' + Date.now(),
                    fecha: selectedDateStr,
                    titulo: val,
                    descripcion: 'Tarea agendada manualmente para esta fecha.',
                    tipo: 'Tarea',
                    tipoSlug: 'tarea',
                    hora: 'Todo el día',
                    isCustom: true,
                    done: false
                });

                saveCustomTasks();
                inputDayTaskText.value = '';
                formAddDayTask.style.display = 'none';

                renderCalendar();
                renderDayEvents(selectedDateStr);
            });
        }

        // Inicialización
        renderCalendar();
        renderDayEvents(selectedDateStr);
    </script>

    {{> footer}}
</body>
</html>
