<header class="header">
    <div class="header__container">
        <a href="/" class="header__brand" title="Gestor de Casos Legales">
            <span class="header__logo">
                <svg class="header__logo-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                    <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                    <path d="M7 21h10"/>
                    <path d="M12 3v18"/>
                    <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
                </svg>
            </span>
            <div class="header__brand-text-wrap">
                <span class="header__brand-text">Gestor de Casos</span>
                <span class="header__brand-sub">Gestión Jurídica</span>
            </div>
        </a>
        <nav class="header__nav">
            <ul class="header__menu">
                <li class="header__item">
                    <a href="/" class="header__link {{#nav_casos}}header__link--active{{/nav_casos}}" data-nav="casos">
                        <svg class="header__link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                        </svg>
                        <span>Casos</span>
                    </a>
                </li>
                <li class="header__item">
                    <a href="/calendario" class="header__link {{#nav_calendario}}header__link--active{{/nav_calendario}}" data-nav="calendario">
                        <svg class="header__link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <span>Calendario</span>
                    </a>
                </li>
                <li class="header__item">
                    <a href="/tareas" class="header__link header__nav-link {{#nav_tareas}}header__link--active{{/nav_tareas}}" data-nav="tareas">
                        <svg class="header__link-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 11 12 14 22 4"/>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                        </svg>
                        <span>Casos del día y tareas</span>
                    </a>
                </li>
            </ul>
        </nav>
        <div class="header__profile">
            <div class="header__avatar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
            </div>
            <div class="header__profile-info">
                <span class="header__profile-name">Dr. M. Valenzuela</span>
                <span class="header__profile-subtitle">T° 84 F° 122 CPACF</span>
            </div>
        </div>
    </div>
</header>
<script>
    (function() {
        try {
            var path = window.location.pathname;
            var links = document.querySelectorAll('.header__link');
            var matchFound = false;
            links.forEach(function(link) {
                var href = link.getAttribute('href');
                if (href === path || (href === '/' && (path === '' || path === '/'))) {
                    link.classList.add('header__link--active');
                    matchFound = true;
                } else if (href !== '/' && path.indexOf(href) === 0) {
                    link.classList.add('header__link--active');
                    matchFound = true;
                } else if (!link.classList.contains('header__link--active')) {
                    link.classList.remove('header__link--active');
                }
            });
            if (!matchFound && (path === '' || path === '/')) {
                var homeLink = document.querySelector('.header__link[href="/"]');
                if (homeLink) homeLink.classList.add('header__link--active');
            }
        } catch (e) {}
    })();
</script>
